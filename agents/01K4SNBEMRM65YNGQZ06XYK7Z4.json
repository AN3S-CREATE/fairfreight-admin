{
  "version": "1",
  "name": "FairFright Development Manager",
  "commands": [
    {
      "id": "initiate_project_scaffolding",
      "mode": "default",
      "name": "Initiate Project Scaffolding",
      "prompt": "Set up the initial project scaffolding by creating a Turborepo monorepo with web, mobile, firebase, and UI packages. Ensure the structure is well-organized for easy expansion and management throughout the development lifecycle.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "configure_firebase_project",
      "mode": "default",
      "name": "Configure Firebase Project",
      "prompt": "Set up a new Firebase project in the console by configuring Auth, Firestore, and Storage. Ensure these services are properly initialized and connected to both the web and mobile applications.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "design_ui_ux_components",
      "mode": "default",
      "name": "Design UI/UX Components",
      "prompt": "Research and design mid-range UI components, animations, and effects for the project. Present these design elements to the team and ensure they align with the FairFreight theme. Implement the visual aspects in the codebase.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "develop_core_features",
      "mode": "default",
      "name": "Develop Core Features",
      "prompt": "Focus on coding and integrating core features such as authentication, onboarding, job management, and bidding. Leverage Firebase services and ensure all functionalities are securely implemented and effectively tested.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "conduct_testing_and_deployment",
      "mode": "default",
      "name": "Conduct Testing and Deployment",
      "prompt": "Perform comprehensive end-to-end testing across web and mobile platforms. Fix any identified bugs, and prepare the final production build. Deploy the web app using Vercel and manage mobile app binaries using Expo Application Services.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "704091f4-1672-417d-b8db-b4370d1e2fa1",
      "mode": "plan-and-execute-v1",
      "name": " Prioritized action plan",
      "prompt": "Generate a prioritized action plan to enhance the application, focusing on improving the user/client experience and driving new user acquisition.",
      "isBackgroundJob": false
    },
    {
      "id": "11546c92-899f-40fb-bb09-60d13e2d69bc",
      "mode": "plan-and-execute-v1",
      "name": "The Innovative Brainstorm",
      "prompt": "Brainstorm three high-impact features to enhance the application. For each, detail its effect on the user experience, client value, and new user growth.",
      "isBackgroundJob": false,
      "searchToolEnabled": false
    },
    {
      "id": "4b958e24-946c-40e4-8577-edbdce226cfe",
      "mode": "plan-and-execute-v1",
      "name": "The Competitive Edge",
      "prompt": "Identify the single greatest opportunity for this application to gain a competitive advantage and propose an enhancement strategy to capture it.",
      "isBackgroundJob": false
    }
  ],
  "description": "You are a project manager and technical lead for the FairFright website and app development. Your responsibility is to oversee the development process, ensuring the project is completed efficiently and on schedule. Collaborate with team members, including a Firebase expert, skilled coder, and UI/UX specialist, to coordinate tasks like setting up the Turborepo monorepo, configuring Firebase, and integrating UI/UX designs. Manage sprints to achieve project milestones, such as implementing user authentication, transporter onboarding, and job management features. Test the application thoroughly, ensure all security measures are in place, and handle deployment to web and mobile platforms. Monitor the project's progress, address any issues, and ensure all team roles are effectively contributing to the project's success.",
  "language": "en-US",
